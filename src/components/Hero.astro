---
---

<section class="relative overflow-hidden bg-ink-950 pt-40 pb-24 sm:pt-48 sm:pb-32">
	<div class="pointer-events-none absolute inset-0">
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(184,72,31,0.18),_transparent_55%)]"></div>
		<div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_75%)]"></div>
	</div>

	<div class="relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-[1.3fr_1fr]">
		<div>
			<p class="reveal mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-brand-400">
				Dakwerken &middot; Elektriciteit &middot; Beton &amp; algemene bouw
			</p>

			<h1 class="reveal reveal-delay-1 text-4xl font-black uppercase leading-[1.05] tracking-tight text-white sm:text-6xl">
				Gebouwd op <span class="text-brand-500">vakmanschap</span>.
			</h1>

			<p class="reveal reveal-delay-2 mt-6 max-w-xl text-base leading-relaxed text-cream-100/60 sm:text-lg">
				A&amp;T Projects BV is een uitvoerende bouwpartner voor professionele opdrachtgevers in
				België. Van dakrenovatie en elektrische installatie tot complete bouwondersteuning:
				duidelijk afgesproken, veilig uitgevoerd.
			</p>

			<div class="reveal reveal-delay-3 mt-10 flex flex-col gap-4 sm:flex-row">
				<a
					href="#contact"
					class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-7 py-4 text-sm font-semibold text-white transition-transform hover:scale-105 hover:bg-brand-400"
				>
					Bespreek uw project
					<span aria-hidden="true">&rarr;</span>
				</a>
				<a
					href="#diensten"
					class="inline-flex items-center justify-center rounded-full border border-white/15 px-7 py-4 text-sm font-semibold text-white transition-colors hover:border-brand-400 hover:text-brand-400"
				>
					Bekijk onze diensten
				</a>
			</div>
		</div>

		<div class="reveal reveal-delay-2 relative">
			<div class="aspect-[4/5] rounded-2xl bg-brand-500 p-8 shadow-2xl shadow-brand-900/40">
				<div class="flex h-full flex-col justify-between">
					<div class="flex flex-1 items-center justify-center">
						<img
							src="/images/logo.png"
							alt="A&T Projects BV"
							class="h-48 w-48 cursor-pointer rounded-full bg-white p-2 shadow-lg transition-transform duration-300 hover:scale-110 active:scale-110 sm:h-60 sm:w-60"
							width="240"
							height="240"
						/>
					</div>
					<div>
						<p class="text-4xl font-black uppercase leading-none text-white sm:text-5xl">Sinds<br />1989</p>
						<p class="mt-3 pr-16 text-sm text-white/70 sm:pr-0">Vakmanschap dat meegroeit met uw project.</p>
					</div>
				</div>
			</div>
			<a
				href="#veiligheid"
				aria-label="Bekijk onze certificaten"
				class="absolute -bottom-3 -right-3 block h-16 w-16 sm:-bottom-5 sm:-right-5 sm:h-24 sm:w-24"
			>
				<img
					src="/images/certificates/vca-badge.png"
					alt="VCA** gecertificeerd"
					class="h-full w-full cursor-pointer rounded-2xl bg-white p-1.5 shadow-xl transition-transform duration-300 ease-out rotate-[-6deg] hover:rotate-0 hover:scale-125 active:rotate-0 active:scale-125"
					width="96"
					height="96"
					loading="lazy"
				/>
			</a>
		</div>
	</div>
</section>
