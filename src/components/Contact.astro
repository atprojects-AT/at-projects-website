---
const contact = {
	email: 'contactatprojects@gmail.com',
	phones: ['0470 21 93 08', '0497 99 06 06'],
	addressLine1: 'Kerkstraat 108',
	addressLine2: '9050 Gentbrugge',
};

const social = [
	{ label: 'LinkedIn', href: '#' },
	{ label: 'Instagram', href: '#' },
	{ label: 'Facebook', href: '#' },
];
---

<section id="contact" class="relative overflow-hidden bg-brand-500 px-6 py-24 sm:py-32">
	<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(0,0,0,0.15),_transparent_60%)]"></div>

	<div class="relative mx-auto grid max-w-6xl grid-cols-1 gap-16 lg:grid-cols-[1.1fr_1fr]">
		<div class="reveal">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-white/70">Uw volgende project</p>
			<h2 class="text-3xl font-black uppercase leading-tight tracking-tight text-white sm:text-5xl">
				Een betrouwbare partner voor uw werf.
			</h2>
			<p class="mt-6 max-w-md text-white/80">
				Vertel ons wat uw project nodig heeft. Wij nemen snel en persoonlijk contact met u op.
			</p>
		</div>

		<div class="reveal reveal-delay-2 rounded-2xl border border-white/20 bg-black/10 p-8 backdrop-blur-sm">
			<dl class="space-y-6">
				<div>
					<dt class="text-xs font-semibold uppercase tracking-widest text-white/60">E-mail</dt>
					<dd class="mt-1">
						<a href={`mailto:${contact.email}`} class="font-medium text-white hover:underline">{contact.email}</a>
					</dd>
				</div>
				<div>
					<dt class="text-xs font-semibold uppercase tracking-widest text-white/60">Telefoon</dt>
					<dd class="mt-1 space-y-1">
						{
							contact.phones.map((phone) => (
								<a href={`tel:${phone.replace(/\s+/g, '')}`} class="block font-medium text-white hover:underline">
									{phone}
								</a>
							))
						}
					</dd>
				</div>
				<div>
					<dt class="text-xs font-semibold uppercase tracking-widest text-white/60">Adres</dt>
					<dd class="mt-1 font-medium text-white">
						{contact.addressLine1}<br />
						{contact.addressLine2}
					</dd>
				</div>
				<div>
					<dt class="text-xs font-semibold uppercase tracking-widest text-white/60">Sociale media</dt>
					<dd class="mt-2 flex gap-3">
						{
							social.map((item) => (
								<a
									href={item.href}
									aria-label={item.label}
									class="flex h-10 w-10 items-center justify-center rounded-full border border-white/30 text-white transition-colors hover:bg-white hover:text-brand-600"
								>
									<span class="text-xs font-bold">{item.label[0]}</span>
								</a>
							))
						}
					</dd>
				</div>
			</dl>
		</div>
	</div>
</section>
