---
const contact = {
	email: 'contactatprojects@gmail.com',
	phones: ['0470 21 93 08', '0497 99 06 06'],
	addressLine1: 'Kerkstraat 108',
	addressLine2: '9050 Gentbrugge',
};

const social = [
	{ label: 'LinkedIn', href: '#' },
	{ label: 'Instagram', href: '#' },
	{ label: 'Facebook', href: '#' },
];
---

<section id="contact" class="relative overflow-hidden bg-brand-500 px-6 py-24 sm:py-32">
	<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(0,0,0,0.15),_transparent_60%)]"></div>

	<div class="relative mx-auto grid max-w-6xl grid-cols-1 gap-16 lg:grid-cols-[1.1fr_1fr]">
		<div class="reveal">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-white/70">Uw volgende project</p>
			<h2 class="text-3xl font-black uppercase leading-tight tracking-tight text-white sm:text-5xl">
				Een betrouwbare partner voor uw werf.
			</h2>
			<p class="mt-6 max-w-md text-white/80">
				Vertel ons wat uw project nodig heeft. Wij nemen snel en persoonlijk contact met u op.
			</p>

			<form data-contact-form class="mt-10 max-w-md space-y-4">
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					<div>
						<label for="contact-name" class="mb-1.5 block text-xs font-semibold uppercase tracking-widest text-white/85">
							Naam
						</label>
						<input
							id="contact-name"
							name="name"
							type="text"
							required
							autocomplete="name"
							class="w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder-white/60 outline-none transition-colors focus:border-white focus:bg-white/15"
							placeholder="Uw naam"
						/>
					</div>
					<div>
						<label for="contact-phone" class="mb-1.5 block text-xs font-semibold uppercase tracking-widest text-white/85">
							Telefoon
						</label>
						<input
							id="contact-phone"
							name="phone"
							type="tel"
							autocomplete="tel"
							class="w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder-white/60 outline-none transition-colors focus:border-white focus:bg-white/15"
							placeholder="Optioneel"
						/>
					</div>
				</div>

				<div>
					<label for="contact-email" class="mb-1.5 block text-xs font-semibold uppercase tracking-widest text-white/85">
						E-mail
					</label>
					<input
						id="contact-email"
						name="email"
						type="email"
						required
						autocomplete="email"
						class="w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder-white/60 outline-none transition-colors focus:border-white focus:bg-white/15"
						placeholder="uw@email.be"
					/>
				</div>

				<div>
					<label for="contact-message" class="mb-1.5 block text-xs font-semibold uppercase tracking-widest text-white/85">
						Bericht
					</label>
					<textarea
						id="contact-message"
						name="message"
						rows="4"
						required
						class="w-full resize-none rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder-white/60 outline-none transition-colors focus:border-white focus:bg-white/15"
						placeholder="Beschrijf kort uw project of vraag"
					></textarea>
				</div>

				<button
					type="submit"
					class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-white px-8 py-3.5 text-sm font-bold uppercase tracking-widest text-brand-600 transition-all duration-300 hover:scale-105 hover:bg-ink-950 hover:text-white disabled:cursor-not-allowed disabled:opacity-70"
				>
					Verzenden
				</button>

				<p data-form-status class="mt-3 text-sm font-medium" aria-live="polite"></p>
			</form>
		</div>

		<div class="reveal reveal-delay-2 rounded-2xl border border-white/20 bg-black/10 p-8 backdrop-blur-sm">
			<dl class="space-y-6">
				<div>
					<dt class="text-xs font-semibold uppercase tracking-widest text-white/60">E-mail</dt>
					<dd class="mt-1">
						<a href={`mailto:${contact.email}`} class="font-medium text-white hover:underline">{contact.email}</a>
					</dd>
				</div>
				<div>
					<dt class="text-xs font-semibold uppercase tracking-widest text-white/60">Telefoon</dt>
					<dd class="mt-1 space-y-1">
						{
							contact.phones.map((phone) => (
								<a href={`tel:${phone.replace(/\s+/g, '')}`} class="block font-medium text-white hover:underline">
									{phone}
								</a>
							))
						}
					</dd>
				</div>
				<div>
					<dt class="text-xs font-semibold uppercase tracking-widest text-white/60">Adres</dt>
					<dd class="mt-1 font-medium text-white">
						{contact.addressLine1}<br />
						{contact.addressLine2}
					</dd>
				</div>
				<div>
					<dt class="text-xs font-semibold uppercase tracking-widest text-white/60">Sociale media</dt>
					<dd class="mt-2 flex gap-3">
						{
							social.map((item) => (
								<a
									href={item.href}
									aria-label={item.label}
									class="flex h-10 w-10 items-center justify-center rounded-full border border-white/30 text-white transition-colors hover:bg-white hover:text-brand-600"
								>
									<span class="text-xs font-bold">{item.label[0]}</span>
								</a>
							))
						}
					</dd>
				</div>
			</dl>
		</div>
	</div>
</section>
