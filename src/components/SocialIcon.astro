---
import type { SocialName } from '../data/social';

interface Props {
	name: SocialName;
	class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
---

{
	name === 'linkedin' && (
		<svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" />
		</svg>
	)
}
{
	name === 'instagram' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18" rx="5" />
			<circle cx="12" cy="12" r="4" />
			<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
		</svg>
	)
}
{
	name === 'facebook' && (
		<svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.1 15.94 2 14.64 2 11.93 2 10 3.66 10 6.7v2.8H7v4h3V22h4v-8.5z" />
		</svg>
	)
}
