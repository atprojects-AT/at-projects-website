---
const steps = [
	{
		num: '01',
		title: 'Kennismaking',
		desc: 'We bespreken de werf, planning, technische noden en gewenste bezetting.',
	},
	{
		num: '02',
		title: 'Duidelijk voorstel',
		desc: 'U krijgt heldere afspraken over inzet, timing en praktische organisatie.',
	},
	{
		num: '03',
		title: 'Aan de slag',
		desc: 'Onze ploeg start voorbereid en blijft rechtstreeks aanspreekbaar tijdens het project.',
	},
];
---

<section id="over-ons" class="bg-cream-100 px-6 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl">
		<div class="reveal max-w-2xl">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">Zo werken we</p>
			<h2 class="text-3xl font-black uppercase tracking-tight text-ink-950 sm:text-4xl">
				Van aanvraag tot uitvoering.
			</h2>
		</div>

		<div class="mt-16 grid grid-cols-1 gap-10 sm:grid-cols-3">
			{
				steps.map((step, i) => (
					<div class:list={['reveal', `reveal-delay-${i + 1}`]}>
						<span class="text-sm font-black text-brand-500">{step.num}</span>
						<h3 class="mt-3 text-lg font-bold text-ink-950">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink-950/60">{step.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
