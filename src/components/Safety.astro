---
const points = [
	{
		num: '01',
		title: 'Veiligheid & compliance',
		desc: 'A&T Projects BV is VCA**-gecertificeerd voor industriële elektriciteitswerken. Binnen onze organisatie zijn ook VCA VOL- en BA4-attesten aanwezig.',
	},
	{
		num: '02',
		title: 'Flexibele projectteams',
		desc: 'Ervaren vakmensen die gericht kunnen worden ingezet voor tijdelijke versterking of langere projectondersteuning.',
	},
	{
		num: '03',
		title: 'Heldere opvolging',
		desc: 'Korte communicatielijnen, transparante urenopvolging en concrete afspraken over planning, bezetting en uitvoering.',
	},
];

const certificates = [
	{
		title: 'VCA**',
		issuer: 'Cetradex Certificatie B.V.',
		logo: '/images/partners/cetradex.png',
	},
	{
		title: 'VCA VOL',
		issuer: 'Centre CFS',
		logo: '/images/partners/cfs.png',
	},
	{
		title: 'BA4',
		issuer: 'nxtpro / Skilled by bv',
		logo: '/images/partners/nxtpro.svg',
	},
];
---

<section id="veiligheid" class="bg-ink-900 px-6 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl">
		<div class="reveal max-w-2xl">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand-400">Professionele slagkracht</p>
			<h2 class="text-3xl font-black uppercase leading-tight tracking-tight text-white sm:text-4xl">
				Capaciteit voor de werf.<br />Aandacht voor elk detail.
			</h2>
		</div>

		<div class="mt-16 grid grid-cols-1 gap-16 lg:grid-cols-[1.1fr_1fr]">
			<div class="divide-y divide-white/10 border-t border-white/10">
				{
					points.map((point, i) => (
						<div class:list={['reveal grid grid-cols-[60px_1fr] gap-6 py-8', `reveal-delay-${i + 1}`]}>
							<span class="text-lg font-black text-brand-500">{point.num}</span>
							<div>
								<h3 class="font-bold text-white">{point.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-cream-100/50">{point.desc}</p>
							</div>
						</div>
					))
				}
			</div>

			<div class="reveal reveal-delay-2 grid grid-cols-3 items-start gap-4 self-start">
				{
					certificates.map((cert) => (
						<div>
							<div class="flex h-24 items-center justify-center rounded-lg border-4 border-white bg-white p-4 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-brand-500/20 hover:shadow-2xl">
								<img
									src={cert.logo}
									alt={cert.issuer}
									class="max-h-full max-w-full object-contain"
									loading="lazy"
								/>
							</div>
							<p class="mt-2 text-xs font-semibold text-white">{cert.title}</p>
							<p class="text-[11px] text-cream-100/40">{cert.issuer}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
