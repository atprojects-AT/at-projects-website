---
const points = [
	{
		num: '01',
		title: 'Veiligheid & compliance',
		desc: 'A&T Projects BV is VCA**-gecertificeerd voor industriële elektriciteitswerken. Binnen onze organisatie zijn ook VCA VOL- en BA4-attesten aanwezig.',
	},
	{
		num: '02',
		title: 'Flexibele projectteams',
		desc: 'Ervaren vakmensen die gericht kunnen worden ingezet voor tijdelijke versterking of langere projectondersteuning.',
	},
	{
		num: '03',
		title: 'Heldere opvolging',
		desc: 'Korte communicatielijnen, transparante urenopvolging en concrete afspraken over planning, bezetting en uitvoering.',
	},
];

const certificates = [
	{
		title: 'VCA**',
		issuer: 'Cetradex Certificatie B.V.',
		img: '/images/certificates/vca-company-certificate.jpg',
		position: 'center top',
	},
	{
		title: 'VCA VOL',
		issuer: 'Diploma operationeel leidinggevende',
		img: '/images/certificates/vca-diploma.jpg',
		position: 'center top',
	},
	{
		title: 'BA4',
		issuer: 'nxtpro / Skilled by bv',
		img: '/images/certificates/ba4-certificate.jpg',
		position: 'center top',
	},
];
---

<section id="veiligheid" class="bg-ink-900 px-6 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl">
		<div class="reveal max-w-2xl">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand-400">Professionele slagkracht</p>
			<h2 class="text-3xl font-black uppercase leading-tight tracking-tight text-white sm:text-4xl">
				Capaciteit voor de werf.<br />Aandacht voor elk detail.
			</h2>
		</div>

		<div class="mt-16 grid grid-cols-1 gap-16 lg:grid-cols-[1.1fr_1fr]">
			<div class="divide-y divide-white/10 border-t border-white/10">
				{
					points.map((point, i) => (
						<div class:list={['reveal grid grid-cols-[60px_1fr] gap-6 py-8', `reveal-delay-${i + 1}`]}>
							<span class="text-lg font-black text-brand-500">{point.num}</span>
							<div>
								<h3 class="font-bold text-white">{point.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-cream-100/50">{point.desc}</p>
							</div>
						</div>
					))
				}
			</div>

			<div class="reveal reveal-delay-2 grid grid-cols-3 items-start gap-4 self-start">
				{
					certificates.map((cert) => (
						<button
							type="button"
							data-cert-trigger
							data-cert-title={cert.title}
							data-cert-issuer={cert.issuer}
							data-cert-img={cert.img}
							class="group cursor-zoom-in text-left"
						>
							<div class="relative aspect-[3/4] overflow-hidden rounded-lg border-4 border-white shadow-lg transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-brand-500/20 group-hover:shadow-2xl">
								<img
									src={cert.img}
									alt={`Certificaat ${cert.title}`}
									class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
									style={`object-position: ${cert.position}`}
									loading="lazy"
								/>
								<div class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/0 opacity-0 transition-opacity group-hover:bg-black/20 group-hover:opacity-100">
									<span class="rounded-full bg-white/90 px-3 py-1 text-[10px] font-semibold uppercase tracking-wide text-ink-950">Bekijk</span>
								</div>
							</div>
							<p class="mt-2 text-xs font-semibold text-white">{cert.title}</p>
							<p class="text-[11px] text-cream-100/40">{cert.issuer}</p>
						</button>
					))
				}
			</div>
		</div>
	</div>

	<div
		data-cert-lightbox
		class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/90 px-6 backdrop-blur-sm"
	>
		<button data-cert-close class="absolute right-6 top-6 text-cream-100/60 transition-colors hover:text-white" aria-label="Sluiten">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
		<div class="max-h-[90vh] max-w-md text-center">
			<img
				data-cert-lightbox-img
				src=""
				alt=""
				class="mx-auto max-h-[75vh] w-auto rounded-lg border-4 border-white object-contain shadow-2xl"
			/>
			<p data-cert-lightbox-title class="mt-4 font-semibold text-white"></p>
			<p data-cert-lightbox-issuer class="text-sm text-cream-100/50"></p>
		</div>
	</div>
</section>

<script>
	const lightbox = document.querySelector<HTMLElement>('[data-cert-lightbox]');
	const titleEl = document.querySelector('[data-cert-lightbox-title]');
	const issuerEl = document.querySelector('[data-cert-lightbox-issuer]');
	const imgEl = document.querySelector<HTMLImageElement>('[data-cert-lightbox-img]');

	document.querySelectorAll<HTMLElement>('[data-cert-trigger]').forEach((btn) => {
		btn.addEventListener('click', () => {
			if (titleEl) titleEl.textContent = btn.dataset.certTitle ?? '';
			if (issuerEl) issuerEl.textContent = btn.dataset.certIssuer ?? '';
			if (imgEl) {
				imgEl.src = btn.dataset.certImg ?? '';
				imgEl.alt = `Certificaat ${btn.dataset.certTitle ?? ''}`;
			}
			lightbox?.classList.remove('hidden');
			lightbox?.classList.add('flex');
			document.body.style.overflow = 'hidden';
		});
	});

	const closeLightbox = () => {
		lightbox?.classList.add('hidden');
		lightbox?.classList.remove('flex');
		document.body.style.overflow = '';
	};

	document.querySelector('[data-cert-close]')?.addEventListener('click', closeLightbox);
	lightbox?.addEventListener('click', (e) => {
		if (e.target === lightbox) closeLightbox();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeLightbox();
	});
</script>
