---
import SocialIcon from './SocialIcon.astro';
import { social } from '../data/social';
import { contact } from '../data/contact';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-950 px-6 py-10">
	<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 sm:flex-row">
		{/* Phone: logo and social icons share one row. From sm up the wrapper dissolves (contents) and both sit in the main row. */}
		<div class="flex w-full items-center justify-between gap-4 sm:contents">
			<div class="flex items-center gap-3">
				<img src="/images/logo.png" alt="A&T Projects BV" class="h-9 w-9" width="36" height="36" />
				<span class="whitespace-nowrap text-sm font-bold uppercase tracking-wide text-white max-[359px]:text-xs">A&amp;T Projects BV</span>
			</div>

			<div class="flex shrink-0 gap-3">
				{
					social.map((item) => (
						<a
							href={item.href}
							aria-label={item.label}
							class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/70 transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-400 hover:text-brand-400"
						>
							<SocialIcon name={item.name} />
						</a>
					))
				}
			</div>
		</div>

		<div class="self-start text-left text-xs text-cream-100/60 sm:self-auto">
			<p>© {year} A&amp;T Projects BV. Alle rechten voorbehouden.</p>
			<p class="mt-1">BTW {contact.vatNumber}</p>
			<p class="mt-1"><a href="/privacyverklaring" class="underline transition-colors hover:text-brand-400">Privacyverklaring</a></p>
		</div>
	</div>
</footer>
