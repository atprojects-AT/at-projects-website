---
import { contact, toE164 } from '../data/contact';

const phone = contact.phones[0];

const nav = [
	{ href: '/#diensten', label: 'Diensten' },
	{ href: '/#realisaties', label: 'Realisaties' },
	{ href: '/#over-ons', label: 'Over ons' },
	{ href: '/#veiligheid', label: 'Veiligheid' },
	{ href: '/#contact', label: 'Contact' },
];

const ticker = 'DAKWERKEN · ELEKTRICITEIT · BETON & ALGEMENE BOUW · PROFESSIONELE UITVOERING';
---

<header data-site-header class="fixed top-0 left-0 right-0 z-50 bg-ink-950">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="/#" class="flex items-center gap-3 transition-transform duration-300 hover:scale-105 active:scale-105">
			<img src="/images/logo.png" alt="A&T Projects BV" class="h-13 w-13 sm:h-14 sm:w-14" width="56" height="56" />
			<span class="hidden flex-col leading-none sm:flex">
				<span class="text-sm font-bold uppercase tracking-wide text-white">A&amp;T Projects</span>
				<span class="text-[10px] uppercase tracking-widest text-cream-200/50">sinds 1989</span>
			</span>
		</a>

		<nav class="hidden items-center gap-8 md:flex">
			{
				nav.map((item) => (
					<a
						href={item.href}
						class="text-sm font-medium text-cream-100/70 transition-colors hover:text-brand-400"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<a
			href="/#contact"
			class="hidden rounded-full bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:scale-105 hover:bg-brand-400 md:inline-block"
		>
			Contact
		</a>

		<div class="flex items-center gap-4 md:hidden">
			<a
				href={`tel:${toE164(phone)}`}
				class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-500 text-white transition-transform active:scale-95"
				aria-label={`Bel ${phone}`}
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.5 1.21l-2.26 1.13a11.04 11.04 0 005.52 5.52l1.13-2.26a1 1 0 011.21-.5l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" />
				</svg>
			</a>

			<button data-menu-btn class="text-cream-100" aria-label="Open menu">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>

	<div data-mobile-menu class="hidden border-t border-white/10 bg-ink-950 px-6 py-4 md:hidden">
		<nav class="flex flex-col gap-4">
			{
				nav.map((item) => (
					<a href={item.href} class="text-sm font-medium text-cream-100/70 hover:text-brand-400">
						{item.label}
					</a>
				))
			}
			<a href="/#contact" class="mt-2 rounded-full bg-brand-500 px-5 py-2.5 text-center text-sm font-semibold text-white">
				Contact
			</a>
		</nav>
	</div>

	<div class="overflow-hidden border-t border-white/10 bg-ink-900 py-2">
		<div class="ticker-track flex w-max gap-12 whitespace-nowrap text-[11px] font-semibold uppercase tracking-widest text-cream-100/60">
			<span>{ticker}</span>
			<span>{ticker}</span>
			<span>{ticker}</span>
			<span>{ticker}</span>
		</div>
	</div>
</header>

<style>
	.ticker-track {
		animation: ticker 32s linear infinite;
	}

	@keyframes ticker {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-25%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ticker-track {
			animation: none;
		}
	}
</style>
