---
const services = [
	{
		num: '01',
		title: 'Dakwerken',
		desc: 'Duurzame oplossingen voor platte daken, roofing, isolatie, renovatie en herstellingen — met aandacht voor waterdichtheid, veiligheid en een verzorgde afwerking.',
		tags: ['Roofing', 'Dakrenovatie', 'Isolatie'],
	},
	{
		num: '02',
		title: 'Elektriciteitswerken',
		desc: 'Industriële, tertiaire en residentiële installaties: verlichting, kabels, kabelgoten, leidingen, laagspanning, data, branddetectie en noodverlichting.',
		tags: ['Industrieel', 'Tertiair', 'Residentieel'],
	},
	{
		num: '03',
		title: 'Algemene bouw- en betonwerken',
		desc: 'Praktische uitvoering en ondersteuning voor betonwerken, bekistingswerken, afbraak, nieuwbouw en binnenafwerking — afgestemd op planning en kwaliteitsnormen.',
		tags: ['Betonwerken', 'Bekisting', 'Afbraak & ruwbouw', 'Binnenafwerking'],
	},
];
---

<section id="diensten" class="bg-cream-50 px-6 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl">
		<div class="reveal max-w-2xl">
			<p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">Onze expertise</p>
			<h2 class="text-3xl font-black uppercase tracking-tight text-ink-950 sm:text-4xl">
				Uitvoering die vooruitgaat.
			</h2>
		</div>

		<div class="mt-16 divide-y divide-ink-950/10 border-t border-ink-950/10">
			{
				services.map((service, i) => (
					<div class:list={['reveal grid grid-cols-1 gap-6 py-10 sm:grid-cols-[80px_1fr] sm:gap-10', `reveal-delay-${(i % 3) + 1}`]}>
						<span class="text-2xl font-black text-brand-500">{service.num}</span>
						<div>
							<h3 class="text-xl font-bold text-ink-950 sm:text-2xl">{service.title}</h3>
							<p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-950/60 sm:text-base">{service.desc}</p>
							<div class="mt-5 flex flex-wrap gap-2">
								{
									service.tags.map((tag) => (
										<span class="rounded-full border border-ink-950/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-ink-950/60">
											{tag}
										</span>
									))
								}
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
